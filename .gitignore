.venv/
.venv38/
__pycache__/
*.pyc
.DS_Store
config.toml
logs/
.env
.env.*
!.env.example

.venv312/

# Runtime workspace/memory artifacts
agent_workspace/memory/
!agent_workspace/memory/
agent_workspace/memory/*
!agent_workspace/memory/.gitkeep

# Runtime data snapshots / indexes
data/
!data/
data/*
!data/.gitkeep
!data/identity.md
!data/memory/
data/memory/*
!data/memory/*.md
!data/people/
data/people/*
!data/people/*.md
!data/skills/
data/skills/**
!data/skills/**/
!data/skills/**/SKILL.md
!data/skills/**/builder.py
!data/skills/**/*.tsv
!data/skills/**/*.json

# Local provider config
config/*.json
!config/.gitkeep

# Local persona / personal notes (use *.example.md as templates)
agent_workspace/IDENTITY.md
agent_workspace/MEMORY.md
agent_workspace/TOOLS.md
!agent_workspace/*.example.md
