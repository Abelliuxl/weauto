# ============================================================
# Receiver Mode
# ============================================================
# detached_windows: each chat is a detached WeChat window (recommended)
# legacy_list: old whole-app list detector (requires calibration)
processing_mode = "native"
receiver_mode = "detached_windows"
detached_window_title_filter = []
detached_window_output_dir = "data/detached_window_images"
# screencapture: memory-stable but slower; quartz: faster but may grow Mach memory, use watchdog.
detached_window_capture_backend = "screencapture"
detached_debug_save = false
detached_window_resize_on_start = false
detached_window_standard_width = 852
detached_window_standard_height = 970
detached_reply_on_image = false
detached_process_existing_on_start = false
detached_vision_parse_enabled = false

# ============================================================
# Loop & Interaction Timing
# ============================================================
poll_interval_sec = 1.0
action_cooldown_sec = 8.0
normal_reply_interval_sec = 300.0
dry_run = true
activate_wait_sec = 0.6
click_move_duration_sec = 0.18
mouse_down_hold_sec = 0.03
post_select_wait_sec = 0.35
send_after_paste_delay_sec = 0.5

# ============================================================
# Logging & Startup
# ============================================================
log_verbose = true
debug_scan = false
skip_first_action_on_start = true
memory_gc_interval_sec = 60.0
memory_watchdog_max_rss_mb = 1536

# ============================================================
# Session Memory
# ============================================================
memory_enabled = true
memory_store_path = "data/chat_history/_index.json"
memory_short_max_items = 12
memory_short_context_items = 8
memory_summary_update_every = 4
memory_summary_recent_items = 10
memory_summary_max_chars = 500
memory_history_context_items = 24
memory_history_max_items = 1000
memory_append_max_items = 200
impression_append_max_items = 80

# ============================================================
# Person Aliases
# ============================================================
people_aliases_enabled = true
people_aliases_path = "data/config/PEOPLE_ALIASES.md"
mention_send_enabled = false
mention_trigger_suffix = "A"
mention_after_paste_delay_sec = 0.40
mention_after_backspace_delay_sec = 0.70
mention_after_confirm_delay_sec = 0.45
mention_pause_scan_sec = 2.0

# ============================================================
# Admin Session
# ============================================================
admin_commands_enabled = true
admin_session_titles = ["example_admin"]
admin_command_prefix = "/"

# ============================================================
# Bridge Mode
# ============================================================
# processing_mode = "bridge" keeps local receiving/sending rules, but sends
# normalized chat events to an external processor for full reply generation.
bridge_backend = "http" # http | openclaw
bridge_url = "http://127.0.0.1:8766/weauto/reply"
bridge_api_key = ""
bridge_api_key_env = "WEAUTO_BRIDGE_API_KEY"
bridge_timeout_sec = 120.0
bridge_fail_open = true

# Used when bridge_backend = "openclaw". OpenClaw generates the reply, while
# weauto still owns WeChat receiving, mention handling, cooldown, and sending.
bridge_openclaw_cli = "openclaw"
bridge_openclaw_gateway_url = ""
bridge_openclaw_gateway_url_env = "OPENCLAW_GATEWAY_URL"
bridge_openclaw_gateway_token = ""
bridge_openclaw_gateway_token_env = "OPENCLAW_GATEWAY_TOKEN"
bridge_openclaw_agent_id = "main"
bridge_openclaw_session_prefix = "agent:main:weauto"
bridge_openclaw_thinking = "off"
bridge_openclaw_deliver = false
bridge_openclaw_expect_final = true
bridge_openclaw_strip_proxy_env = true

# Persistent WebSocket channel bridge to a remote OpenClaw plugin.
# Set processing_mode = "long_bridge" only after the remote plugin is installed.
long_bridge_url = ""
long_bridge_url_env = "WEAUTO_LONG_BRIDGE_URL"
long_bridge_token = ""
long_bridge_token_env = "WEAUTO_LONG_BRIDGE_TOKEN"
long_bridge_account_id = "default"
long_bridge_timeout_sec = 180.0
long_bridge_reconnect_min_sec = 1.0
long_bridge_reconnect_max_sec = 30.0
long_bridge_heartbeat_sec = 20.0
long_bridge_attachment_max_mb = 20
long_bridge_fail_open = true

# ============================================================
# Agent Actions
# ============================================================
agent_actions_enabled = true
agent_actions_max_per_turn = 2
agent_reply_max_messages_per_turn = 3
agent_actions_fail_open = true
agent_plan_loop_enabled = true
agent_plan_max_rounds = 3
agent_plan_max_total_actions = 6
agent_plan_repeat_limit = 2
agent_plan_observation_max_chars = 5200

# ============================================================
# Web Search
# ============================================================
# Legacy compatibility field. web_search aggregates Tavily, Brave, and Volc Ark.
web_search_provider = "tavily"

tavily_enabled = false
tavily_api_key = ""
tavily_api_key_env = "TAVILY_API_KEY"
tavily_max_results = 3
tavily_timeout_sec = 8.0

brave_enabled = false
brave_api_key = ""
brave_api_key_env = "BRAVE_SEARCH_API_KEY"
brave_max_results = 3
brave_timeout_sec = 8.0

volc_ark_enabled = false
volc_ark_api_key = ""
volc_ark_api_key_env = "ARK_API_KEY"
volc_ark_model = "doubao-seed-1-8-251228"
volc_ark_limit = 8
volc_ark_max_keyword = 3
volc_ark_timeout_sec = 20.0

# ============================================================
# Weather
# ============================================================
weather_enabled = false
weather_provider = "qweather"
weather_default_location = "临沧"
weather_forecast_days = 3

# QWeather JWT is recommended for long-term use.
# After uploading data/secrets/qweather-ed25519-public.pem in QWeather Console,
# fill your dedicated API Host, Credential ID, and Project ID here.
qweather_api_host = ""
qweather_auth_type = "jwt"
qweather_jwt_key_id = ""
qweather_jwt_project_id = ""
qweather_jwt_private_key_path = "data/secrets/qweather-ed25519-private.pem"
qweather_jwt_ttl_sec = 900
qweather_timeout_sec = 8.0

agent_reach_enabled = false
agent_reach_mcporter_cmd = "mcporter"
agent_reach_max_results = 5
agent_reach_timeout_sec = 12.0

# ============================================================
# Python Sandbox
# ============================================================
python_sandbox_restricted = true

# ============================================================
# Heartbeat
# ============================================================
heartbeat_enabled = false
heartbeat_interval_sec = 300.0
heartbeat_min_idle_sec = 20.0
heartbeat_max_actions = 24
heartbeat_max_people = 10
heartbeat_people_history_records = 100

# ============================================================
# Reply Policy & Group Rules
# ============================================================
reply_on_new_message = "已收到消息，我稍后回复你。"
reply_on_mention = "收到@，我看到了，稍后处理。"

mention_keywords = ["@我", "有人@我", "[有人@我]", "［有人@我］"]
mention_any_at = false
group_title_prefixes = ["群"]
group_detect_sender_prefix = true
group_require_sender_prefix_for_new_message = false
group_only_reply_when_mentioned = false
group_allow_llm_no_reply = false
group_reply_keywords = ["@助手", "@机器人", "机器人", "bot", "小助手", "@萨比", "萨比"]
ignore_title_keywords = ["折叠的聊天"]
ignore_exact_titles = ["微信"]

# ============================================================
# Legacy List Mode Geometry
# (only used when receiver_mode = "legacy_list")
# ============================================================
[list_region]
x = 0.065
y = 0.12
w = 0.325
h = 0.82

[chat_context_region]
x = 0.40
y = 0.16
w = 0.57
h = 0.63

[chat_title_region]
x = 0.424679
y = 0.006198
w = 0.342949
h = 0.028926

[chat_title_region_group]
x = 0.424679
y = 0.006198
w = 0.342949
h = 0.028926

[chat_title_region_private]
x = 0.424679
y = 0.006198
w = 0.342949
h = 0.028926

[input_point]
x = 0.73
y = 0.92

# ============================================================
# OCR
# ============================================================
[ocr]
backend = "rapidocr"
enhance = false
target_short_side = 900
max_upscale = 3.2
paddle_lang = "ch"
paddle_use_angle_cls = false
ab_compare_backend = ""
ab_compare_sample_rate = 0.0
ab_compare_max_text_len = 120

# ============================================================
# LLM
# ============================================================
[llm]
enabled = true
base_url = ""
base_url_env = "NVIDIA_BASE_URL"
api_key = ""
api_key_env = "NVIDIA_API_KEY"
model = "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
api_format = "openai"
ollama_native = false
openai_compat_think_mode = "on"
temperature = 0.6
max_tokens = 16384
timeout_sec = 120.0
sarcasm_level = "medium"
reasoning_effort = ""
reasoning_budget = 4096
debug_log_payload = false
debug_log_response = false

decision_enabled = true
decision_on_group = false
decision_on_private = false
decision_fail_open = false
decision_max_tokens = 32
decision_read_chat_context = true
summary_enabled = true
summary_max_tokens = 160
anti_repeat_enabled = true
anti_repeat_window = 4
anti_repeat_similarity = 0.82
anti_repeat_retry = 1

[llm_reply]
enabled = true
openai_compat_think_mode = "on"
reasoning_effort = ""
reasoning_budget = 4096
timeout_sec = 120.0

[llm_decision]
enabled = true
openai_compat_think_mode = "off"
reasoning_effort = ""
reasoning_budget = 0
timeout_sec = 20.0

[llm_planner]
enabled = true
openai_compat_think_mode = "on"
reasoning_effort = ""
reasoning_budget = 8192
timeout_sec = 120.0

[llm_summary]
enabled = true
openai_compat_think_mode = "off"
reasoning_effort = ""
reasoning_budget = 0
timeout_sec = 20.0

[llm_heartbeat]
enabled = true
openai_compat_think_mode = "on"
reasoning_effort = ""
reasoning_budget = 4096
timeout_sec = 60.0

# ============================================================
# Vision
# ============================================================
[vision]
enabled = true
base_url = ""
base_url_env = "OPENAI_BASE_URL"
api_key = ""
api_key_env = "OPENAI_API_KEY"
model = ""
ollama_native = false
openai_compat_think_mode = "on"
timeout_sec = 12.0
max_tokens = 512
response_format_json_object = true
fail_open = true
reasoning_effort = "minimal"
debug_log_payload = false
debug_log_response = false

# ============================================================
# Image Generation / Editing
# ============================================================
[image_generation]
enabled = false
provider = "dashscope_z_image"
base_url = ""
base_url_env = "DASHSCOPE_BASE_URL"
api_key = ""
api_key_env = "DASHSCOPE_API_KEY"
model = "z-image-turbo"
timeout_sec = 90.0
download_timeout_sec = 45.0
default_size = "1024x1024"
output_dir = "data/generated_images"

[image_editing]
enabled = false
provider = "dashscope_qwen_image_edit"
base_url = ""
base_url_env = "DASHSCOPE_BASE_URL"
api_key = ""
api_key_env = "DASHSCOPE_API_KEY"
model = "qwen-image-2.0-pro"
timeout_sec = 120.0
download_timeout_sec = 45.0
default_size = "1024x1024"
output_dir = "data/edited_images"
watermark = false
prompt_extend = true
max_input_bytes = 10485760

# ============================================================
# Control Panel (menu-bar app + web UI)
# ============================================================
# This section is read only by app/main.py (the modern entry point). The bot
# itself (wechat_rpa.config.AppConfig) ignores unknown tables, so adding it is
# safe and does not affect run.py / start_rpa.sh in any way.
# Launch with:  ./start_app.sh          (menu bar + web + bot)
#           or:  ./start_app.sh --headless --host 0.0.0.0   (remote web only)
[webui]
# Bind address. 127.0.0.1 = local only; 0.0.0.0 = allow remote IP access.
host = "127.0.0.1"
port = 8721
# In-memory ring buffer size for the live log view / SSE stream.
log_ring_lines = 2000
# Auto-respawn the bot subprocess when it crashes.
auto_restart = true
# Minimum seconds between crash-triggered restarts (anti-storm guard).
restart_min_interval_sec = 30.0
# When false, the supervisor stays idle after the bot exits (manual control).
supervisor_enabled = true
